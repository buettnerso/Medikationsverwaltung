<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Datei: app.manifest
  Zweck: Deklariert Betriebssystem-Kompatibilität, DPI-Verhalten, lange Pfade und
         die benötigte Ausführungsstufe der unpackaged WinUI-Desktopanwendung.
  Die Anwendung läuft bewusst mit den Rechten des angemeldeten Benutzers (asInvoker).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="amd64" name="Medikationsverwaltung" type="win32"/>
  <description>Medikationsverwaltung für studienspezifische Excel-Bestellübersichten</description>
  <!-- Kennzeichnet die Anwendung als mit aktuellen Windows-Versionen kompatibel. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <!-- Per-Monitor-DPI und lange Pfade sind wichtig für große Tabellen und Netzlaufwerke. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <!-- Keine Administratorrechte anfordern: Dateizugriffe erfolgen mit Benutzerrechten. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
